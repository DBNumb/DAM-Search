<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.dam.search.frontend.ui.SearchEngineUI">
    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
            </padding>
            <HBox spacing="10.0">
                <Label text="Motor:" />
                <ComboBox fx:id="engineCombo" prefWidth="180.0" />
                <TextField fx:id="queryField" promptText="Introduce la consulta" HBox.hgrow="ALWAYS" />
                <Button fx:id="searchButton" text="Buscar" onAction="#onSearch" />
                <ProgressIndicator fx:id="progress" visible="false" prefWidth="28.0" prefHeight="28.0" />
            </HBox>
            <HBox spacing="8.0">
                <Button text="Importar PDF" onAction="#onLoadPdf" />
                <Button text="Importar DOCX" onAction="#onLoadDocx" />
                <Button text="Reindexar" onAction="#onReindexAll" />
                <Button text="Eliminar seleccionado" onAction="#onRemoveSelected" />
            </HBox>
            <Label fx:id="statusLabel" text="Listo." />
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.3,0.72">
            <ListView fx:id="docsList" />
            <ListView fx:id="resultsList" />
            <TextArea fx:id="previewArea" wrapText="true" />
        </SplitPane>
    </center>
    <bottom>
        <Label fx:id="footerLabel" text="Sin resultados." BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets top="8.0" right="12.0" bottom="8.0" left="12.0"/>
            </padding>
        </Label>
    </bottom>
</BorderPane>

